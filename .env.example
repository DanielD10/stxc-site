# ─────────────────────────────────────────────────────────────
# These go in Vercel → your project → Settings → Environment Variables.
# For testing on your own computer, copy this file to .env.local
# and fill it in. NEVER upload a file with real keys to GitHub.
# ─────────────────────────────────────────────────────────────

# REQUIRED IN VERCEL — from resend.com → API Keys.
# Leave it commented out on your computer and the form runs in safe dry-run mode.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED IN VERCEL — inbox that receives inquiries. Comma-separate for more than one.
# While using Resend's test sender, this MUST be the email you signed up to Resend with.
# TO_EMAIL=jrduran75@yahoo.com

# OPTIONAL — once the business domain is verified in Resend:
# FROM_EMAIL=STXC Website <website@yourdomain.com>

# OPTIONAL — shown in emails
# COMPANY_NAME=South Texas Construction By Design
# COMPANY_PHONE=(210) 555-0123

# OPTIONAL — "true" emails the customer a "we got your message" receipt.
# Only works after FROM_EMAIL is set to a verified domain.
# SEND_CONFIRMATION=true

# OPTIONAL — extra websites allowed to post to the form (comma-separated)
# ALLOWED_ORIGINS=https://example.com

# OPTIONAL — shared rate limiting across servers (upstash.com, free tier)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL — phone alerts (pick one or both). See SETUP.md Step 9.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NTFY_TOPIC=

# LOCAL TESTING ONLY — 1 = print emails in the terminal instead of sending
# EMAIL_DRY_RUN=1
