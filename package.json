{
  "name": "stxc-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm test",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr --emptyOutDir && node scripts/prerender.js",
    "preview": "vite preview",
    "test": "node --test tests/api.test.js tests/worker.test.js",
    "check": "node scripts/prelaunch-check.js",
    "test-alert": "node scripts/test-alert.js",
    "telegram-id": "node scripts/telegram-id.js",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.4",
    "wrangler": "^4.149.0"
  }
}
